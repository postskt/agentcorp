{
  "name": "agentcorp",
  "version": "0.2.0",
  "description": "A native DSH plugin + MCP server that connects WorkBuddy, DeepSeek Harness, ZCode and Google Antigravity into one AI company.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./mcp": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/",
    "src/",
    "prompts/",
    "public/",
    "README.md",
    "NPM_PUBLISH.md",
    "LICENSE"
  ],
  "bin": {
    "agentcorp": "src/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "agent",
    "collaboration",
    "multi-agent",
    "workbuddy",
    "zcode",
    "antigravity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postskt/agentcorp.git"
  },
  "homepage": "https://github.com/postskt/agentcorp"
}
